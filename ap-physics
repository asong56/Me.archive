= III · Forces & Dynamics
// ══════════════════════════════════════════════════════════════════════

== Newton's Laws

#entry($bold(F)_"net" = m bold(a) = frac(d bold(p), d t)$, note: [
    N-I: $bold(F)_"net" = 0 => bold(a) = 0$. \
    N-III: $bold(F)_(A->B) = -bold(F)_(B->A)$ (forces act on different objects).
])

#entry($f_s <= mu_s N quad f_k = mu_k N$, note: [
    $N$: normal force. Typically $mu_s > mu_k$.
])

#entry($F = -k x$, note: [Hooke's law. Restoring force opposes displacement.])

== Rotational Dynamics

#entry($tau = r F sin theta = I alpha quad I = integral r^2 thin d m = I_"cm" + M d^2$, note: [
    Parallel-axis theorem. Common $I$: solid sphere $frac(2,5)M R^2$; cylinder $frac(1,2)M R^2$; rod (center) $frac(1,12)M L^2$; hoop $M R^2$. \
    Rolling: $v = omega r$, $K = frac(1,2)m v^2 + frac(1,2)I omega^2$.
])

== Simple Harmonic Motion

// Mass-spring ↔ LC circuit analogy across centre axis
#aheader[Mass-Spring][LC Circuit]
#block(breakable: false, width: 100%)[
    #set par(leading: 0.75em, spacing: 0.75em)
    #table(
        columns: (1fr, 1fr),
        stroke: (x, y) => if x == 1 { (left: 0.4pt + c-border) } else { none },
        inset: (x: 8pt, y: 4pt),
        align: alignment.top + alignment.left,
        [
            #set text(size: 8.5pt)
            coord: $x$ \
            inertia: $m$ \
            restoring: $k$ \
            $omega = sqrt(k\/m)$ \
            $E = frac(1,2)k x^2 + frac(1,2)m v^2$
        ],
        [
            #set text(size: 8.5pt)
            coord: $q$ \
            inertia: $L$ \
            restoring: $1\/C$ \
            $omega = sqrt(1\/(L C))$ \
            $E = Q^2\/(2C) + frac(1,2)L I^2$
        ],
    )
    #v(4pt)
    #line(length: 100%, stroke: 0.3pt + c-border)
]

#entry($T_"spring" = 2pi sqrt(frac(m,k)) quad T_"pend" = 2pi sqrt(frac(L,g))$, note: [
    Pendulum valid for $theta lt.tilde 15°$; independent of mass and amplitude.
])

#entry($frac(d^2 x, d t^2) = -omega^2 x quad => quad x(t) = A cos(omega t + phi_0)$, note: [
    $v_"max" = A omega$ at $x = 0$. $quad a_"max" = A omega^2$ at $x = plus.minus A$.
])

== Gravitation & Orbits

#entry($F = G frac(m_1 m_2, r^2) quad g = frac(G M, R^2) quad v_"orb" = sqrt(frac(G M, r))$)

#entry($frac(T^2, a^3) = frac(4pi^2, G M)$, note: [
    Kepler III. I: elliptical orbits, central body at one focus. II: equal areas in equal times.
])

== Fluid Mechanics

#entry($F_b = rho_f V_"disp" g$, note: [Archimedes: buoyancy = weight of displaced fluid.])

#entry($A_1 v_1 = A_2 v_2 quad P + frac(1,2)rho v^2 + rho g h = "const"$, note: [
    Continuity (incompressible) + Bernoulli. High speed → low static pressure.
])


