= I · Kinematics
// ══════════════════════════════════════════════════════════════════════

// Translation ↔ Rotation analogy: left/right across the A5 centre axis
#aheader[Translation][Rotation ↔ connection]
#block(breakable: false, width: 100%)[
    #set par(leading: 0.75em, spacing: 0.75em)
    #table(
        columns: (1fr, 1fr),
        stroke: (x, y) => if x == 1 { (left: 0.4pt + c-border) } else { none },
        inset: (x: 8pt, y: 4pt),
        align: alignment.top + alignment.left,
        [
            #set text(size: 8.5pt)
            $x$ — position \
            $v = dot(x)$ — velocity \
            $a = dot.double(x)$ — acceleration \
            $m$ — inertia \
            $bold(F) = m bold(a)$ — dynamics \
            $K = frac(1,2)m v^2$
        ],
        [
            #set text(size: 8.5pt)
            $theta$ — position #h(1fr) $x = r theta$ \
            $omega = dot(theta)$ — ang. vel. #h(1fr) $v = r omega$ \
            $alpha = dot.double(theta)$ — ang. acc. #h(1fr) $a_t = r alpha$ \
            $I = integral r^2 d m$ — rotational inertia \
            $bold(tau) = I bold(alpha)$ #h(1fr) $bold(tau) = bold(r) times bold(F)$ \
            $K = frac(1,2)I omega^2$
        ],
    )
    #v(4pt)
    #line(length: 100%, stroke: 0.3pt + c-border)
]

== Const.-accel. equations

// Translational and rotational kinematic equations side by side
#aheader[Translational ($a$ = const)][Rotational ($alpha$ = const)]

#dual(
    $v = v_0 + a t$,
    $omega = omega_0 + alpha t$,
)
#dual(
    $x = x_0 + v_0 t + frac(1,2)a t^2$,
    $theta = theta_0 + omega_0 t + frac(1,2)alpha t^2$,
)
#entry($v^2 = v_0^2 + 2a(x - x_0)$, note: [
    Eliminates $t$. Projectile: $a_x = 0$, $a_y = -g$ independently.
])

== Calculus Forms

#entry(
    $v(t) = frac(d x, d t) quad a(t) = frac(d^2 x, d t^2) quad x = x_0 + integral_(t_0)^t v thin d t'$,
    note: [Use when $a != "const"$. Same form holds for $theta, omega, alpha$.]
)

== Circular Motion

#entry($a_c = frac(v^2, r) = omega^2 r$, note: [
    Centripetal — directed toward center; provided by tension, gravity, friction etc. Not an extra force. \
    Centrifugal force is fictitious (rotating frame only).
])


