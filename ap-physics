// ── Colour palette (5 semantic colors) ──────────────────────────────
#let c-bg     = rgb("#F8F8FA")
#let c-border = rgb("#D4D4DE")
#let c-text   = rgb("#2E2E38")
#let c-muted  = rgb("#7A7A8A")
#let c-blue   = rgb("#2563EB")

// ── Page: A4 landscape, two columns, folds to A5 ─────────────────────
#set page(
    paper: "a4",
    flipped: true,
    margin: (x: 13mm, y: 13mm),
    fill: c-bg,
    columns: 2,
)
#set text(
    font: ("Inter", "Liberation Sans", "DejaVu Sans"),
    size: 9pt,
    fill: c-text,
    weight: "regular",
    tracking: 0.01em,
)
#set par(leading: 0.65em, justify: false, spacing: 0.65em)

// ── Level-1 heading: major section title ─────────────────────────────
#show heading.where(level: 1): it => {
    block(width: 100%, breakable: false)[
        #line(length: 100%, stroke: 0.5pt + c-border)
        #v(4pt)
        #text(size: 9.5pt, weight: "bold", fill: c-blue, tracking: 0.02em)[#it.body]
        #v(5pt)
    ]
}

// ── Level-2 heading: subsection ──────────────────────────────────────
#show heading.where(level: 2): it => {
    v(10pt)
    block(width: 100%, breakable: false)[
        #text(size: 8.5pt, weight: "semibold", fill: c-text)[#it.body]
        #v(2pt)
        #line(length: 100%, stroke: 0.4pt + c-border)
        #v(5pt)
    ]
}

// ── entry: formula line + optional indented note ──────────────────────
#let entry(eq, note: none) = {
    block(breakable: false, width: 100%)[
        #v(5pt)
        #eq
        #if note != none {
            v(3pt)
            block(
                stroke: (left: 1.2pt + c-border),
                inset: (left: 7pt, top: 1pt, bottom: 1pt),
                width: 100%,
            )[
                #set text(size: 7.8pt, fill: c-muted)
                #set par(leading: 0.55em, spacing: 0.55em)
                #note
            ]
        }
        #v(7pt)
    ]
}

// ── dual: two formula columns with a centre rule via table stroke ──────
#let dual(left, right, note-left: none, note-right: none) = {
    v(5pt)
    block(breakable: false, width: 100%)[
        #table(
            columns: (1fr, 1fr),
            stroke: (x, y) => if x == 1 { (left: 0.4pt + c-border) } else { none },
            inset: (x: 8pt, y: 0pt),
            align: alignment.top + alignment.left,
            // left cell
            {
                left
                if note-left != none {
                    v(2pt)
                    block(
                        stroke: (left: 1.2pt + c-border),
                        inset: (left: 7pt, top: 1pt, bottom: 1pt),
                        width: 100%,
                    )[
                        #set text(size: 7.8pt, fill: c-muted)
                        #set par(leading: 0.55em, spacing: 0.55em)
                        #note-left
                    ]
                }
            },
            // right cell
            {
                right
                if note-right != none {
                    v(2pt)
                    block(
                        stroke: (left: 1.2pt + c-border),
                        inset: (left: 7pt, top: 1pt, bottom: 1pt),
                        width: 100%,
                    )[
                        #set text(size: 7.8pt, fill: c-muted)
                        #set par(leading: 0.55em, spacing: 0.55em)
                        #note-right
                    ]
                }
            },
        )
    ]
    v(7pt)
}

// ── alabel: small caps label for analogy headers ──────────────────────
#let alabel(body) = {
    text(size: 7pt, weight: "semibold", tracking: 0.07em, fill: c-muted)[#upper(body)]
}

// ── aheader: paired column labels, matching dual() column widths ───────
#let aheader(left, right) = {
    v(8pt)
    table(
        columns: (1fr, 1fr),
        stroke: none,
        inset: (x: 8pt, y: 0pt),
        alabel[#left],
        alabel[#right],
    )
    v(3pt)
}


