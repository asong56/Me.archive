= II · Conservation Laws
// ══════════════════════════════════════════════════════════════════════

== Momentum & Impulse

#entry($bold(p) = m bold(v) quad bold(J) = integral bold(F) thin d t = Delta bold(p)$, note: [
    $bold(F)_"ext" = 0 => sum bold(p)_i = sum bold(p)_f$ \
    Elastic: $bold(p)$ and $E_k$ both conserved. Perfectly inelastic: $bold(p)$ only.
])

== Work & Energy

#entry($W = F d cos theta = integral bold(F) dot d bold(x)$, note: [
    Constant-force form is a special case; equals area under $F$–$x$ curve.
])

#entry($E_k = frac(1,2)m v^2 quad U_g = m g h quad U_s = frac(1,2)k x^2$, note: [
    $bold(F) = -nabla U$. #h(6pt) If $W_"nc" = 0$: $E_k + U = "const"$.
])

#entry($U_g = -frac(G M m, r) quad P = frac(W, t) = bold(F) dot bold(v)$, note: [
    $G = 6.674 times 10^(-11)$ N·m²/kg². $U_g -> 0$ as $r -> infinity$. Escape speed: $v_"esc" = sqrt(2G M\/R)$.
])

== Angular Momentum

#entry($bold(L) = I bold(omega) = bold(r) times bold(p) quad bold(tau)_"net" = frac(d bold(L), d t)$, note: [
    $tau = I alpha$ when $I = "const"$. \
    Conservation: $bold(tau)_"ext" = 0 => bold(L) = "const"$.
])

== Center of Mass

#entry(
    $bold(r)_"cm" = frac(sum m_i bold(r)_i, M) = frac(integral bold(r) thin d m, M)$,
    note: [$bold(F)_"ext" = M bold(a)_"cm"$.]
)


